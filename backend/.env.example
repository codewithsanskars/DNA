PORT=5000
NODE_ENV=development

# PostgreSQL — set DATABASE_URL, or the discrete PG* vars.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swfs_portal
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=swfs_portal
# PGUSER=postgres
# PGPASSWORD=postgres
# PGSSL=false

JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Okta SSO — the app's redirect URI (below) must be registered on the Okta
# app integration ("Sign-in redirect URIs"). Works with either app type:
#  - "SPA" (Client Authentication: None, PKCE required) — leave
#    OKTA_CLIENT_SECRET unset; PKCE alone authenticates the code exchange.
#  - confidential "Web" app — set OKTA_CLIENT_SECRET below too.
OKTA_DOMAIN=https://your-domain.okta.com
OKTA_CLIENT_ID=your_okta_client_id
# OKTA_CLIENT_SECRET=your_okta_client_secret
OKTA_REDIRECT_URI=http://localhost:5000/api/auth/okta/callback
# 'default' unless this app uses a custom-named authorization server, or the
# Org Authorization Server (set to 'org' in that case).
OKTA_AUTH_SERVER_ID=default

FRONTEND_URL=http://localhost:5173
